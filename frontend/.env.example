# Backend URL (sem barra final). Vite injeta estas variáveis EM TEMPO DE BUILD —
# depois de alterar, corre `npm run build` outra vez.
VITE_API_URL=https://backend.seudominio.com
# Mesmo URL mas com protocolo websocket, se o /ws não for servido pelo mesmo host.
VITE_WS_URL=wss://backend.seudominio.com
